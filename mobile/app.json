{
  "expo": {
    "name": "Vọng",
    "slug": "vong",
    "version": "0.10.2",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "vong",
    "android": {
      "package": "app.vong.mobile",
      "versionCode": 14,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0b0f"
      }
    },
    "ios": {
      "bundleIdentifier": "app.vong.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "@react-native-tvos/config-tv",
        {
          "androidTVRequired": true,
          "androidTVBanner": "./assets/tv-banner.png",
          "androidTVIcon": "./assets/icon.png"
        }
      ],
      "./modules/vong-audio/app.plugin.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0b0b0f"
        }
      ],
      "./plugins/with-e2e-network.js",
      "./plugins/with-release-signing.js"
    ],
    "extra": {
      "origin": "https://streammusic.vercel.app"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
