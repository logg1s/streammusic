{
  "expo": {
    "name": "Vọng",
    "slug": "vong",
    "version": "0.5.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "vong",
    "android": {
      "package": "app.vong.mobile",
      "versionCode": 6
    },
    "ios": {
      "bundleIdentifier": "app.vong.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "./modules/vong-audio/app.plugin.js",
      "expo-splash-screen",
      "./plugins/with-e2e-network.js",
      "./plugins/with-release-signing.js"
    ],
    "extra": {
      "origin": "https://streammusic.vercel.app"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
