# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# ảnh chụp màn hình do công cụ kiểm thử sinh ra
.playwright-mcp/
/*.png

# Rust / Tauri
/src-tauri/target/
/src-tauri/gen/schemas/

# Expo / React Native (mobile)
mobile/node_modules/
mobile/.expo/
mobile/android/
mobile/ios/
mobile/modules/*/android/build/
mobile/*.jks

# anh chup man hinh may ao
.shots/
mobile/credentials/

# release binaries — these belong on GitHub Releases, not in git
/Vong_*.apk
*.apk
*.exe
*.msi
*.dmg
*.AppImage
